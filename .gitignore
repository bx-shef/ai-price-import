# Dependencies
node_modules/

# Nuxt / build output
.nuxt/
.output/
.data/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Claude Code local session settings (machine-specific)
.claude/settings.local.json

# Logs / OS
*.log
.DS_Store
.idea/

# Runtime
uploads/

# Visual-verification captures (may show a real portal's CRM data/domains) — dev-only
screenshots/

# Legacy code kept for porting — has its own toolchain; ignore its build artifacts
legacy/**/.nuxt/
legacy/**/node_modules/
legacy/**/vendor/
legacy/**/.phpunit.cache/
legacy/**/__pycache__/
legacy/**/*.pyc

# Generated symlink / nuxt local rc
dist
.nuxtrc

# Local Redis artefacts — appear when a dev Redis is started from the repo root
# (pnpm loadtest:queue). Start it with `--dir /tmp` to avoid them entirely.
# Never part of the project; tests/noLocalArtifacts.test.ts guards the index.
dump.rdb
*.rdb
appendonly.aof
appendonlydir/

# A/B-замер промпта (pnpm ab:prompt). Артефакт несёт суммы и имена файлов РЕАЛЬНЫХ клиентских
# документов, а репозиторий публичный. Дефолтный --out кладёт его прямо в корень.
# Гард индекса — tests/noLocalArtifacts.test.ts.
ab-prompt*.json
probe-328-showcase.json
probe-todo-carrier.json
