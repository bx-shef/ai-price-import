# procure-ai (redesign) — backend/runtime environment. Copy to .env; never commit secrets.
# Как всё устроено — docs/PROCESS.md; что в каком состоянии — docs/PROJECT_MAP.md.

# ── Persistence ───────────────────────────────────────────────────────────────
# Postgres (tokens, jobs, extracted text/docs, metrics). Backend no-ops storage without it.
# NOTE: docker-compose.prod.yml DERIVES DATABASE_URL from POSTGRES_* below (single source,
# can't drift from the db password), so in prod this value is overridden. It IS used as-is
# for local dev (docker-compose.yml). Keep the password here == POSTGRES_PASSWORD for dev.
DATABASE_URL=postgres://procure:procure@db:5432/procure
# Redis (BullMQ pipeline queues). Without it the pipeline is disabled and uploads 503.
# Also overridden by docker-compose.prod.yml (redis://redis:6379).
REDIS_URL=redis://redis:6379
# Хранилище задач публичного демо (async AI-путь, GH #78). Пусто/`memory` — in-memory,
# один процесс (дефолт; демо в проде = 1 контейнер). `redis` — общее хранилище (переживает
# рестарт, работает за балансировщиком без sticky-сессий); требует REDIS_URL выше. Включать
# ТОЛЬКО при масштабировании демо-бэкенда на >1 реплику.
DEMO_JOBSTORE=memory
# Демо: макс. параллельных AI-разборов (public /api/demo/extract) — защита от перегруза
# инференса публичной страницей. Дефолт 2.
DEMO_AI_MAX_CONCURRENCY=2
# Демо: каталог для временных файлов разбора (PDF/скан). Дефолт /tmp/procure-demo.
DEMO_TMP_DIR=/tmp/procure-demo
# Демо: глобальный СУТОЧНЫЙ потолок AI-разборов (#321) — пер-IP лимит и конкуренция ограничивают
# темп, а это ограничивает сумму (жечь LLM-ключ «медленно, но бесконечно» больше нельзя). Считается
# в Redis (переживает рестарт; без Redis — in-memory на процесс, об этом пишется warning). Дефолт
# 200, кламп [1, 100000]. Детерминированный путь (текст/CSV/Excel, образцы лендинга) бюджет не тратит.
DEMO_DAILY_LIMIT=

# ── Ресурсы воркера (минимальный профиль) ─────────────────────────────────────
# Конкуренция очередей извлечения/агента/CRM. Дефолты 4/2/4. На МИНИМАЛЬНОМ хосте
# (2 vCPU) снизьте до ≤ числа ядер — иначе несколько тяжёлых OCR разом упираются в
# 90с-таймаут (ложные ошибки). См. GH #95 и docs/PROCESS.md §12.3 «Масштабирование».
QUEUE_EXTRACT_CONCURRENCY=4
QUEUE_AGENT_CONCURRENCY=2
QUEUE_CRM_CONCURRENCY=4

# Роль экземпляра при масштабировании (docs/PROCESS.md §12.3). Один образ — три роли:
#   не задано (по умолчанию)      — всё в одном контейнере: и обработка, и крон;
#   QUEUE_WORKERS=0               — только API и крон (события, продление токенов, тревоги);
#   QUEUE_CRON=0 + RUN_MIGRATION=0 — только обработка; такой контейнер можно размножать.
# ⚠ Крон-роль должна быть ровно у ОДНОГО экземпляра: события установки/удаления обязаны
# обрабатываться по порядку, а тревоги — не дублироваться по числу реплик.
QUEUE_WORKERS=
QUEUE_CRON=
# Миграцию БД на старте гоняет только основной экземпляр. У реплик-обработчиков — 0.
RUN_MIGRATION=

# Сколько часов хранится статус задания импорта в Redis (имя файла, результат, кто загрузил).
# По умолчанию 48. Дольше держать незачем: серверного списка заданий нет, историю ведёт браузер.
IMPORT_JOB_TTL_HOURS=
# Ограничить число потоков tesseract/OpenMP (иначе один OCR разворачивается на все ядра
# и N параллельных процессов дерутся за CPU). На минимуме — 1 или 2. Пусто = дефолт tesseract.
# Пробрасываются в субпроцессы (allow-list subprocessEnv, GH #99); OMP_NUM_THREADS — синоним.
OMP_THREAD_LIMIT=
OMP_NUM_THREADS=

# ── Bitrix24 app (OAuth, multitenant) ─────────────────────────────────────────
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# application_token is DELIVERED by ONAPPINSTALL and remembered per-portal (B24
# «Безопасность в обработчиках») — the first install authenticates via its access_token,
# later events verify against the stored token. So LEAVE THIS EMPTY normally. Set it only
# to add an extra global gate on first install; a placeholder here 403s every install.
B24_APPLICATION_TOKEN=
# AES-256-GCM key (base64, 32 bytes) for refresh-token encryption at rest:  openssl rand -base64 32
B24_TOKEN_ENC_KEY=
# Proactive OAuth keep-alive cadence in HOURS (#175) — refreshes only near-expiry idle
# portals so their refresh_token doesn't die on day 180. Runs on the cron/primary instance
# (QUEUE_CRON=1) and needs B24_CLIENT_ID/SECRET. Default 24; clamped to [1h, 168h].
TOKEN_KEEPALIVE_HOURS=24
# TTL (DAYS) for the portal_tombstone event-ordering guard (#77). The hourly retention sweep drops
# tombstones older than this — a months-old one can no longer be raced (B24 doesn't retry online
# events that long), so this caps growth (one row per permanently-uninstalled portal). Default 30;
# clamped to [1, 365].
TOMBSTONE_TTL_DAYS=30

# ── LLM extractor (OpenAI-compatible chat, in-process) ────────────────────────
# One transport; the provider is chosen by LLM_PROVIDER = bitrixgpt | deepseek | custom.
# ⚠ Неизвестное значение НЕ ДАЁТ СЕРВИСУ ПОДНЯТЬСЯ (#416): п. 5.3 Политики называет двух провайдеров
# поимённо, и опечатка молча увела бы трафик на провайдера по умолчанию — документ бы врал.
# ⚠ `custom` допустим ТОЛЬКО в инсталляции клиента и требует SELF_HOSTED=1 (п. 12.3 Политики).
LLM_PROVIDER=bitrixgpt
# Признак инсталляции на инфраструктуре клиента. Пусто/не 1 = облако издателя.
# SELF_HOSTED=1

# bitrixgpt (default) — Bitrix Vibecode AI Router, model bitrix/bitrixgpt-5.5.
# AI Router routes away from direct КНР inference (#215). Key is a Vibecode key (vibe_api_…);
# a dedicated BITRIXGPT_API_KEY overrides VIBE_API_KEY if set.
# ⚠ Ключ обязан быть ВАЙБКОД-ключом (`vibe_*`). Живой прогон 2026-08-04: AI Router принимает
# `Authorization: Bearer` только для них, прочим отвечает «401 API key required. Use X-Api-Key
# header instead». Наш транспорт шлёт Bearer, поэтому ключ другого вида даст отказ «ключ
# недействителен» при полностью настоящем ключе.
VIBE_API_KEY=
# BITRIXGPT_API_KEY=
# BITRIXGPT_MODEL=bitrix/bitrixgpt-5.5

# deepseek — https://api.deepseek.com/v1, model deepseek-v4-flash. Faster, but КНР jurisdiction (#215).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# custom — any OpenAI-compatible endpoint.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ── Storage / misc ────────────────────────────────────────────────────────────
# Ephemeral upload dir (bytes deleted after extraction / on uninstall / by TTL sweep).
UPLOAD_DIR=/data/uploads
# crm-sync idempotency marker originator (stamped into the created entity's originId/originatorId
# or xmlId, then searched before create). Namespaces our marker so it never matches a portal's own
# external-source data. Empty → defaults to the repo code «ai-price-import».
IMPORT_ORIGINATOR_ID=

# ── Public (build-time + request-time) ────────────────────────────────────────
# Absolute site URL — REQUIRED in prod (builds the B24 event-handler URL).
# Яндекс Метрика — счётчик ЛЕНДИНГА (#297): по нему ведут рекламу и смотрят клики.
# Пусто ⇒ счётчика нет вовсе (dev, staging, self-hosted у клиента) — у аналитики издателя нет
# причин работать на чужом сервере. В in-portal экранах счётчик не поднимается независимо от
# значения (самозаглушение во фрейме), Вебвизор выключен в коде: на лендинге стоит демо-разбор,
# и запись сессии унесла бы содержимое чужого документа. Нужен и на build (пререндер), и в рантайме.
# NUXT_PUBLIC_METRIKA_ID=

NUXT_PUBLIC_SITE_URL=https://price-import.bx-shef.by
# ⚠ Что задано в .env — то и побеждает: compose передаёт и `KEY=` (пустое = заданное), Nitro
# накатывает env поверх runtimeConfig и запечённого в образ. Поэтому две переменные ниже
# ЗАКОММЕНТИРОВАНЫ — раскомментировать только чтобы осознанно перебить образ (локальный запуск,
# staging). `NUXT_PUBLIC_SITE_URL` выше — намеренно ЗАДАНА: краулерные роуты читают её в рантайме,
# прод обязан явно объявить свой хост.
# Build commit sha — ЗАПЕКАЕТСЯ В ОБРАЗ на сборке (CI передаёт github.sha); виден в /api/health,
# в подвале и в телеметрии. Строка в серверном .env перебивает запечённое, и прод показывает «dev».
# NUXT_PUBLIC_COMMIT_SHA=dev
# Build date YYYY-MM-DD — <lastmod> в /sitemap.xml, читается в рантайме. Пусто/битое → элемент
# опускается (неверный lastmod хуже отсутствующего).
# NUXT_PUBLIC_BUILD_DATE=
# Bitrix24 Market listing code override for the «оцените приложение» modal. Empty → the app's real
# slug (shef.priceimport, from landing.ts) is used. Set only to point at a different listing.
NUXT_PUBLIC_B24_MARKET_CODE=

# ── Operator login (service zone /queues) — optional ──────────────────────────
# Empty password disables operator login. Use a dedicated session secret (not the enc key).
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=

# ── Edge security for the no-nginx target ("black hole" Vibecode VM) ───────────
# Set to 1 ONLY when the app is directly internet-facing (no nginx in front). Then Nitro
# self-applies the security headers nginx would (CSP + B24 frame-ancestors, nosniff,
# Referrer-Policy, HSTS) and an app-level login brute-force throttle. Behind nginx leave
# it EMPTY/0 — else you get a double CSP and a login throttle keyed on the proxy IP.
APP_EDGE_SECURITY=
# Escape hatch for APP_EDGE_SECURITY. Default off → per-IP limits key on the real TCP peer
# (socket.remoteAddress), spoof-proof. Set to 1 ONLY after live-verifying the platform ingress
# (e.g. the Vibecode tunnel) is a trusted proxy that appends the real client as the LAST
# X-Forwarded-For hop — otherwise every client collapses into one bucket (demo/login lockout).
APP_EDGE_TRUST_XFF=
# Request-time limits with APP_EDGE_SECURITY=1 (#322) — the no-nginx analog of nginx
# client_header_timeout / client_body_timeout (both 60s) + Node's total requestTimeout.
# Defaults (ms): idle 60000, headers 60000, total 300000; clamp [5s, 1h]. Behind nginx ignored.
EDGE_SOCKET_IDLE_MS=
EDGE_HEADERS_TIMEOUT_MS=
EDGE_REQUEST_TIMEOUT_MS=

# ── Prod compose only (docker-compose.prod.yml) ───────────────────────────────
# Bare host for the shared nginx-proxy vhost + ACME cert (NOT a URL — no scheme/path).
# Must match the host in NUXT_PUBLIC_SITE_URL above.
DOMAIN=price-import.bx-shef.by
# TLS cert email for acme-companion (Let's Encrypt).
LETSENCRYPT_EMAIL=
# Postgres for the prod `db` service. DATABASE_URL above MUST embed the same password
# and point at host `db` (e.g. postgres://procure:<POSTGRES_PASSWORD>@db:5432/procure).
POSTGRES_USER=procure
POSTGRES_PASSWORD=
POSTGRES_DB=procure

# ── Обратная связь 👍/👎 (#182 канал «сотрудник») ──────────────────────────────
# Канал ВЫКЛЮЧЕН, пока не заданы ОБА. Репо — ОБЯЗАТЕЛЬНО приватный (комментарии
# сотрудников могут нести клиентский контекст; не указывайте публичный код-репо).
# Нет токена/репо → виджет скрыт, POST → 503.
#
# ПРАВА ТОКЕНА (#417). Для приёма отзывов хватает Contents R/W + Issues R/W. Но суточная чистка
# (ниже) удаляет задачи целиком, а это в GitHub требует АДМИНСКИХ прав на репозиторий-приёмник.
# Без них чистка не встанет, а деградирует: задача обезличивается и закрывается, и тогда прежний
# текст остаётся в истории правок — то есть обещание «не более 12 месяцев» исполняется не до конца.
# Об этом приходит отдельная тревога («обезличено вместо удаления»).
# ⚠ Обратная сторона: админский токен читает и веб-роль (роут приёма отзывов). Если это смущает —
# оставьте обычные права и живите с деградацией осознанно, а не по незнанию.
# ⚠ ВТОРОЙ ДЕПЛОЙ (staging, стенд, инсталляция клиента) с ТЕМ ЖЕ приёмником будет чистить его
# тоже — своим сроком из FEEDBACK_RETENTION_MONTHS. На не-боевых стендах оставляйте
# GITHUB_FEEDBACK_REPO пустым.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=
# Срок хранения отзывов в приёмнике, месяцы (#417, п. 8.6 Политики). Пусто → 12.
# Значение больше 12 не принимается: опубликованный документ обещает «не более 12 месяцев», и
# опечатка в env не вправе это продлить. Меньше — можно, это в пользу клиента.
# Чистка идёт раз в сутки и ТОЛЬКО на cron-инстансе (QUEUE_CRON=1).
FEEDBACK_RETENTION_MONTHS=

# ── Публичный сайт: встроенная форма заявки ───────────────────────────────────
# CRM-форма Битрикс24 на лендинге. У всех трёх ключей есть НЕПУСТЫЕ значения по умолчанию
# (nuxt.config.ts — общая форма bx-shef), поэтому здесь они ЗАКОММЕНТИРОВАНЫ: строка `KEY=` в
# конфигурации выглядит как «выключено», хотя на самом деле умолчание всё равно подставится
# (значения читаются на сборке через `||`), — то есть файл вводил бы в заблуждение. Раскомментируйте
# только если нужна СВОЯ форма — тогда заполните все три.
# NUXT_PUBLIC_B24_FORM_ID=
# NUXT_PUBLIC_B24_FORM_SECRET=
# NUXT_PUBLIC_B24_FORM_SCRIPT_URL=

# ── Оповещения о проблемах очередей — Телеграм ────────────────────────────────
# Канал ВЫКЛЮЧЕН, пока не заданы ОБА (наполовину настроенный молча терял бы тревоги).
# Без него тревоги остаются в логе и на /queues — то есть их надо увидеть самому.
#
# Это НАШ канал, не клиентский: сюда пишет наша инфраструктура о своих поломках
# (очередь встала, задачи падают, Redis не читается). В чат ошибок портала это не
# идёт — простой нашей очереди клиенту ни о чём не говорит.
#
# Сообщение уходит ОДИН раз на поломку, а не на каждую пятиминутную проверку, плюс
# отдельное «восстановилось». Канал, который повторяется, перестают читать — и тогда
# он не сработает в тот единственный раз, ради которого заведён.
#
# Где взять: токен — у @BotFather; id чата — добавить бота в группу, написать в ней
# любое сообщение (без истории getUpdates пуст) и посмотреть getUpdates (у групп id
# отрицательный, вида -100…). Можно и @имя_канала.
#
# КУДА СТАВИТЬ: только на инстанс с включённым кроном (QUEUE_CRON, по умолчанию вкл).
# Сейчас такой контейнер один — backend, поэтому просто сюда. ⚠ При масштабировании
# (worker-контейнеры с QUEUE_CRON=0) переменные им НЕ нужны: раздать их всем репликам
# значит получить каждую тревогу столько раз, сколько реплик, — то есть сломать то самое
# «один раз на поломку», ради которого канал и устроен так, а не иначе.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── OpenTelemetry (телеметрия, docs/PROCESS.md §11.1) ──────────────────────────
# DEFAULT OFF: без OTEL_EXPORTER_OTLP_ENDPOINT бэкенд работает ровно как раньше
# (otel.instrument.mjs при старте ничего не поднимает). Станция сбора (коллектор +
# ClickHouse + Grafana) — отдельный деплой в telemetry-station/.
# ⚠ Указывать БАЗУ эндпоинта (без /v1/traces) — экспортёр сам добавит путь, иначе он удвоится.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# TELEMETRY_ENABLED=1                       # 0 — принудительно выключить даже при заданном эндпоинте
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer CHANGE_ME
# OTEL_SERVICE_NAME=ai-price-import-backend
# OTEL_SERVICE_VERSION=                     # по умолчанию — NUXT_PUBLIC_COMMIT_SHA
