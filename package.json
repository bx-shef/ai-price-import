{
  "name": "ai-price-import",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && vue-tsc --build .nuxt/tsconfig.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "screenshot": "node scripts/screenshot.mjs",
    "demo:pdfs": "node scripts/make-demo-pdfs.mjs",
    "live:crm": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/live-crm-sync.mjs",
    "verify:chat": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-chat.mjs",
    "verify:idem": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-idempotency-live.mjs",
    "verify:article": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-article-match.mjs",
    "seed:b24": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/seed-test-portal.mjs",
    "verify:332": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-332-live.mjs",
    "sdk:smoke": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/sdk-smoke.mjs",
    "loadtest:123": "node scripts/load-test-123.mjs",
    "loadtest:queue": "node scripts/load-test-queue.mjs",
    "og": "node --experimental-strip-types scripts/make-og.mjs",
    "rating-demo": "node scripts/make-rating-demo.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "icons": "node --experimental-strip-types scripts/make-icons.mjs",
    "verify:legal": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-legal-notice.mjs",
    "verify:llm": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-llm-failure.mjs",
    "verify:fail": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/verify-fail-notify.mjs",
    "ab:prompt": "node --experimental-strip-types --import ./scripts/lib/alias-register.mjs scripts/ab-prompt.mjs"
  },
  "dependencies": {
    "@bitrix24/b24icons-vue": "^2.0.8",
    "@bitrix24/b24jssdk": "^2.0.0",
    "@bitrix24/b24jssdk-nuxt": "^2.0.0",
    "@bitrix24/b24ui-nuxt": "^2.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bullmq": "^6.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "nuxt": "^4.5.1",
    "openai": "^7.3.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "gifenc": "^1.0.3",
    "happy-dom": "^20.11.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": ">=1.1.12 <2",
      "minimatch@5>brace-expansion": ">=2.0.2 <3",
      "minimatch@9>brace-expansion": ">=2.0.2 <3",
      "minimatch@10>brace-expansion": ">=5.0.8",
      "tar": ">=7.5.21",
      "uuid": ">=11.1.1 <12"
    }
  }
}
